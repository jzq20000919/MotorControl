# This archive intentionally contains only the current STM32 and ESP32 projects.
/*
!/.gitignore
!/.gitattributes
!/mosquitto-dev.conf
!/CAN_ESP32_集成说明.md
!/MCSDK_MIX_ESP32_LVGL_一周掌握与面试指南.md
!/MCSDK_FOC_MIX/
!/ESP32_LVGL/
!/QtMqttSimpleControl/
!/SguanFOC/
/SguanFOC/*.pdf
/SguanFOC/*.png

# Only the active ESP-IDF application is part of this archive.
/ESP32_LVGL/*
!/ESP32_LVGL/ESP32_LVGL/

# Common editor and operating-system files.
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~

# Generic generated build directories.
**/build/
**/build_*/
**/build-*/
**/Debug/
**/Release/
**/cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/compile_commands.json

# ESP-IDF generated output and dependency cache.  Recreate these with idf.py.
/ESP32_LVGL/ESP32_LVGL/build/
/ESP32_LVGL/ESP32_LVGL/managed_components/
/ESP32_LVGL/ESP32_LVGL/sdkconfig.old
/ESP32_LVGL/ESP32_LVGL/.idf/

# Keil / ARM compiler temporary and generated files.
**/*.crf
**/*.d
**/*.o
**/*.obj
**/*.pbi
**/*.plg
**/*.tmp
**/*.sct
**/*.iex
**/*.tra
**/*.sfr

# STM32CubeMX / Motor Control Workbench temporary and backup files.
/MCSDK_FOC_MIX/*.bak
/MCSDK_FOC_MIX/*.ioc.wb
/MCSDK_FOC_MIX/.extSettings

# Keil user state, logs, listings and generated target output.
/MCSDK_FOC_MIX/MDK-ARM/MCSDK_FOC_MIX/
/MCSDK_FOC_MIX/MDK-ARM/*.uvguix.*
/MCSDK_FOC_MIX/MDK-ARM/*.log
/MCSDK_FOC_MIX/MDK-ARM/*.lst
/MCSDK_FOC_MIX/MDK-ARM/*.map
/MCSDK_FOC_MIX/MDK-ARM/*.htm
/MCSDK_FOC_MIX/MDK-ARM/*.hex
/MCSDK_FOC_MIX/MDK-ARM/*.axf
/MCSDK_FOC_MIX/MDK-ARM/*.lnp
/MCSDK_FOC_MIX/MDK-ARM/*.dep

# Qt generated user and build state.
/MCSDK_FOC_MIX/QtFocMixControl/*.user
/MCSDK_FOC_MIX/QtFocMixControl/.qtc_clangd/

# Qt Creator / CMake generated files for the standalone MQTT control client.
/QtMqttSimpleControl/build/
/QtMqttSimpleControl/build_verify/
/QtMqttSimpleControl/.qtc_clangd/
/QtMqttSimpleControl/**/*.user
/QtMqttSimpleControl/**/*.user.*
/QtMqttSimpleControl/**/.moc/
